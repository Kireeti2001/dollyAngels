# Contact form – optional. If unset, the site opens the visitor's email app instead.
# Get a free form ID from https://formspree.io
# VITE_CONTACT_API=https://formspree.io/f/YOUR_FORM_ID

# Optional: Admin gallery (for elders to add/remove photos from phone)
# Only needed if you set up Supabase + Netlify function (see docs/ADMIN_GALLERY_SETUP.md)
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
