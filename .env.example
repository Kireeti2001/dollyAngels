# Contact form – optional. If unset, the site opens the visitor's email app instead.
# Get a free form ID from https://formspree.io
# VITE_CONTACT_API=https://formspree.io/f/YOUR_FORM_ID

# Or point it at the bundled Netlify function to get an automatic WhatsApp reply.
# See docs/WHATSAPP_AUTOREPLY_SETUP.md
# VITE_CONTACT_API=/.netlify/functions/enquiry

# Server-side only (set these in Netlify, not in the browser bundle):
# WHATSAPP_TOKEN=your-meta-system-user-token
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_TEMPLATE=enquiry_received
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_COUNTRY_CODE=91
# ENQUIRY_FORWARD_URL=https://formspree.io/f/YOUR_FORM_ID

# Optional: Admin gallery (for elders to add/remove photos from phone)
# Only needed if you set up Supabase + Netlify function (see docs/ADMIN_GALLERY_SETUP.md)
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
